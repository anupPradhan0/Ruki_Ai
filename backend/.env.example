mongo_uri=mongodb+srv://username:password@cluster.mongodb.net
db_name=rukiai
jwt_secret=your-super-secret-jwt-key-here
jwt_expire_days=30
ollama_host=http://localhost:11434
ollama_model=gemma4:e2b
smtp_host=smtp.gmail.com
smtp_port=465
smtp_user=your@email.com
smtp_password=your-app-password
email_from=your@email.com
email_receiver=receiver@email.com
app_env=development

# CORS — leave empty in dev to allow any localhost origin via regex.
# In prod, set to a comma-separated list, e.g. https://rukiai.online,https://www.rukiai.online
allowed_origins=

# Docker / MongoDB container (used by docker-compose.yml)
mongo_root_user=admin
mongo_root_password=changeme

