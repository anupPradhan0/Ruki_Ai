# ==============================================================================
# RukiAI frontend — PRODUCTION .env template
# ------------------------------------------------------------------------------
# Copy to .env (or .env.production) BEFORE running `pnpm build`.
#
#   cp .env.production.example .env
#   # then edit .env, set VITE_API_URL to your real backend
#   pnpm build
#
# IMPORTANT — Vite bakes env vars in at BUILD TIME, not runtime.
# Changing this file after `pnpm build` does NOT affect the already-built
# `dist/` output. You must rebuild and redeploy.
# ==============================================================================


# ── Backend API URL ───────────────────────────────────────────────────────────
# Choose ONE based on how you deploy.

# (A) Frontend served on the SAME domain as backend, with nginx/Apache proxying
#     `/api/*` → backend. This is the simplest setup, and the default Docker
#     Compose stack uses it. Leave VITE_API_URL UNSET (or empty) so the
#     frontend uses relative URLs.
# VITE_API_URL=

# (B) Frontend and backend on DIFFERENT domains:
VITE_API_URL=https://<CHANGE_ME_api.yourdomain.com>

# (C) Backend exposed on a non-default port behind the same domain:
# VITE_API_URL=https://yourdomain.com:8000


# ==============================================================================
# CORS REMINDER
# ------------------------------------------------------------------------------
# Whatever URL the browser ends up on (the FRONTEND origin, not the API)
# must be allowed by the backend's CORS config in `backend/main.py`.
#
# The current dev regex `^http://(localhost|127\.0\.0\.1)(:\d+)?$` will NOT
# match production HTTPS origins. For production, set explicit origins, e.g.:
#
#     allow_origins=["https://yourdomain.com"]
#     allow_origin_regex=None
# ==============================================================================
