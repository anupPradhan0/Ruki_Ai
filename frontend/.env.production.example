# ==============================================================================
# RukiAI frontend — PRODUCTION .env template
# ------------------------------------------------------------------------------
# Copy to .env (or .env.production) BEFORE running `pnpm build`.
#
#   cp .env.production.example .env
#   pnpm build
#
# IMPORTANT — Vite bakes env vars in at BUILD TIME, not runtime.
# Changing this file after `pnpm build` does NOT affect the already-built
# `dist/` output. You must rebuild and redeploy.
# ==============================================================================


# ── Backend API URL ───────────────────────────────────────────────────────────
# RukiAI production backend.
VITE_API_URL=https://api.rukiai.online


# ==============================================================================
# DEPLOYMENT NOTES
# ------------------------------------------------------------------------------
# Frontend domain : https://rukiai.online
# Backend domain  : https://api.rukiai.online
#
# Subdomains of `rukiai.online` are SAME-SITE by browser rules — the JWT
# cookie set by api.rukiai.online will be sent on cross-origin fetches from
# rukiai.online without any further config. The frontend already calls fetch
# with `credentials: "include"`.
#
# Backend requirements (set in backend/.env, NOT here):
#   app_env=production
#   allowed_origins=https://rukiai.online,https://www.rukiai.online
#
# These two together flip:
#   - cookies to secure=True, samesite=lax
#   - CORS to allow the explicit origins above
# ==============================================================================
